# ===== Application Settings =====
APP_NAME="{{ cookiecutter.project_name }}"
APP_VERSION="{{ cookiecutter.version }}"
ENVIRONMENT=development
DEBUG=true

# ===== Security =====
SECRET_KEY={{ cookiecutter.jwt_secret_key }}
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# ===== Database =====
DATABASE_TYPE={{ cookiecutter.database_type }}
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_USER=postgres
DATABASE_PASSWORD=postgres
DATABASE_NAME={{ cookiecutter.project_slug }}
DATABASE_ECHO=false

{%- if cookiecutter.use_redis == "yes" %}
# ===== Redis =====
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=
{%- endif %}

{%- if cookiecutter.use_celery == "yes" %}
# ===== Celery =====
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0
{%- endif %}

# ===== CORS =====
CORS_ORIGINS=http://localhost:3000,http://localhost:8000

# ===== Rate Limiting =====
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW_SECONDS=60

# ===== Logging =====
LOG_LEVEL=INFO
LOG_FORMAT=json

# ===== Email (SMTP) =====
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
FROM_EMAIL=noreply@example.com
FROM_NAME={{ cookiecutter.project_name }}

# ===== File Upload =====
UPLOAD_DIR=uploads
UPLOAD_URL=/static/uploads
MAX_UPLOAD_SIZE=10485760

# ===== First Superuser =====
FIRST_SUPERUSER_EMAIL={{ cookiecutter.first_superuser_email }}
FIRST_SUPERUSER_PASSWORD={{ cookiecutter.first_superuser_password }}
